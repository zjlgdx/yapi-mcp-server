{
  "name": "@zjlgdx/yapi-mcp-server",
  "version": "0.8.0",
  "description": "MCP server for interacting with YAPI API documentation platform",
  "license": "MIT",
  "author": "Yvan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjlgdx/yapi-mcp-server.git"
  },
  "homepage": "https://github.com/zjlgdx/yapi-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/zjlgdx/yapi-mcp-server/issues"
  },
  "type": "module",
  "bin": {
    "mcp-server-yapi": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yapi",
    "api",
    "documentation",
    "claude",
    "ai",
    "llm"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "shx mkdir -p dist && tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "watch": "tsc --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22",
    "shx": "^0.4.0",
    "typescript": "^5.7.0"
  }
}

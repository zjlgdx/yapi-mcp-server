{
  "name": "mcp-server-yapi",
  "version": "0.2.0",
  "description": "MCP server for interacting with YAPI API documentation platform",
  "license": "MIT",
  "author": "Yvan",
  "type": "module",
  "bin": {
    "mcp-server-yapi": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yapi",
    "api",
    "documentation",
    "claude",
    "ai",
    "llm"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "shx mkdir -p dist && tsc && shx chmod +x dist/*.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "watch": "tsc --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22",
    "shx": "^0.4.0",
    "typescript": "^5.7.0"
  }
}
